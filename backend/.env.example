FLASK_APP=flasky.py
FLASK_CONFIG=development
FLASK_RUN_PORT=4290
FLASK_RUN_HOST=localhost
SECRET_KEY=xxxxxx

# 邮箱
MAIL_USERNAME=xx
# 邮箱授权码
MAIL_PASSWORD=xx

# 管理员邮箱地址
FLASKY_ADMIN_MAIL=xx

# mysql
DEV_DATABASE_URL=xx

# 七牛云凭证. 
QINIU_ACCESS_KEY=xx
QINIU_SECRET_KEY=xx
QINIU_BUCKET_NAME=xx
QINIU_DOMAIN=http://xx.com

# 应用运行模式（开发模式下执行celery启动命令时，需要加载环境变量）
RUN_APP=True

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
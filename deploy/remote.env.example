# 远程部署配置（remote 模式）
# 复制为 deploy/remote.env 后必须填写“必填项”

# ===== 必填项 =====
REMOTE_HOST=1.2.3.4
REMOTE_USER=ubuntu
REMOTE_BACKEND_DIR=/home/ubuntu/user/loft/backend

# ===== 可选项（有默认值） =====
SSH_PORT=22
REMOTE_TAR_DIR=/home/ubuntu/user

# 本地 backend 目录
LOCAL_BACKEND_DIR=./backend

# remote 默认使用 production compose
COMPOSE_FILE_BASE=docker-compose.prod.yaml

# 应用镜像
BACKEND_IMAGE=nizhenshi/flasky_backend
BACKEND_TAG=latest

# 基础设施镜像（可选）
MYSQL_IMAGE=mysql/mysql-server:8.0
REDIS_IMAGE=redis:latest

# 服务名（与 compose 文件对应）
BACKEND_SERVICE_NAME=backend
MYSQL_SERVICE_NAME=mysql
REDIS_SERVICE_NAME=myredis

# 可选：密码登录（不推荐，推荐 SSH key）
# REMOTE_PASSWORD=your_password
